# Generated by piperoom setup (service_install); service_install rewrites this file.
[Unit]
Description=Piperoom Kafka Connect worker (standalone)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/piperoom-host/project
Environment=JAVA_HOME=/opt/java/openjdk
Environment=LOG_DIR=/piperoom-host/project/logs
ExecStart=/piperoom-host/project/kafka/bin/connect-standalone.sh /piperoom-host/project/connect-standalone.properties
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
