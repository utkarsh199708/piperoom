#!/bin/sh
# The Java 11 runtime this fake host has installed (U8c java-too-old): it
# answers `java -version` the way a JDK 11 does. It is not a JVM and runs
# nothing; the scenario only needs the version a setup run reports.
echo 'openjdk version "11.0.22" 2024-01-16' >&2
echo 'OpenJDK Runtime Environment (build 11.0.22+7-post-Ubuntu-0ubuntu2.22.04)' >&2
echo 'OpenJDK 64-Bit Server VM (build 11.0.22+7-post-Ubuntu-0ubuntu2.22.04, mixed mode, sharing)' >&2
exit 0
