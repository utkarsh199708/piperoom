exports[`room header drift line (X1) > leads a watcher room with the signal kind and window at desktop width 1`] = `"<ul aria-label="Drift the watcher saw" class="m-0 flex list-none flex-col gap-1 p-0"><li data-drift="count_drift" class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-0.5 text-sm tabular-nums"><span class="inline-flex items-center gap-1.5 font-medium text-warning-foreground"><span aria-hidden="true" class="size-1.5 shrink-0 rounded-full bg-warning"></span>count drift</span><span class="min-w-0 max-w-full truncate font-mono text-muted-foreground">public.orders</span><span class="min-w-0 break-words">2.1 % rows missing over 1 h</span><span class="text-xs text-subtle-foreground" title="2026-10-21 10:00:00 UTC to 2026-10-21 11:00:00 UTC">10:00–11:00 UTC</span></li><li data-drift="dup_keys" class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-0.5 text-sm tabular-nums"><span class="inline-flex items-center gap-1.5 font-medium text-warning-foreground"><span aria-hidden="true" class="size-1.5 shrink-0 rounded-full bg-warning"></span>duplicate keys</span><span class="min-w-0 max-w-full truncate font-mono text-muted-foreground">pg.public.orders</span><span class="min-w-0 break-words">3 duplicate events on 2 keys over 1 h</span><span class="text-xs text-subtle-foreground" title="2026-10-21 10:00:00 UTC to 2026-10-21 11:00:00 UTC">10:00–11:00 UTC</span><span class="basis-full min-w-0 break-words text-xs text-muted-foreground">scan capped at 50000 records</span></li></ul>"`;

