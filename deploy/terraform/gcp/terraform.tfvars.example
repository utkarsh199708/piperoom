# Copy to terraform.tfvars and edit. terraform.tfvars is git-ignored.
# Nothing in this file is a secret: secret values go into Secret Manager with
# gcloud (README step 5), never into Terraform variables.

project_id = "my-piperoom-pilot"
region     = "us-central1"

# Host name people will use. You create its DNS A record after the first apply.
domain = "piperoom.corp.example"

# The image you built from the repository Dockerfile and pushed (README step 2).
piperoom_image = "us-central1-docker.pkg.dev/my-piperoom-pilot/piperoom/piperoom:pilot"

# Single sign-on. Register https://<domain>/auth/callback at the IdP.
oidc_issuer    = "https://login.corp.example"
oidc_client_id = "piperoom"

# vertex = Claude on Vertex AI with the VM's service account (no key).
# anthropic = Anthropic API; then store the key in the anthropic-api-key secret.
model_provider = "vertex"
# Must be a Vertex model id when model_provider = "vertex". Take it from Model Garden.
# model         = "<vertex model id>"
# vertex_region = "us-central1"

# Optional Cloud Armor allow-list (office / VPN egress ranges AND your alert
# senders). Empty = reachable from the whole internet behind OIDC login.
allowed_cidrs = []
# allowed_cidrs = ["203.0.113.0/24", "198.51.100.17/32"]

# Cloud SQL. Keep protection on; set false only to destroy (README, Destroy).
db_deletion_protection = true
db_availability_type   = "ZONAL"

# Extra NON-secret server settings (stored in VM metadata and in state).
# extra_env = {
#   PIPEROOM_WATCH_MODE     = "log"
#   PIPEROOM_RETENTION_DAYS = "90"
# }
