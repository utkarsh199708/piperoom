# Piperoom pilot settings.
#
#   cp deploy/pilot.env.example deploy/.env
#
# Then edit deploy/.env. Docker Compose reads deploy/.env by itself and passes
# the server settings on to the container (the list is in
# docker-compose.pilot.yml). deploy/.env is git-ignored: keep it that way, it
# holds secrets.
#
# Rules: no quotes, no spaces around "=". An empty value means "use the default
# (or off)". Lines marked SECRET must come from your secret manager, never from
# a ticket or a chat message. The names match internal/config/config.go.
#
# Read docs/pilot/permissions.md first and create the read-only accounts it lists.

# =============================================================================
# 1. Required
# =============================================================================

# SECRET. Anthropic API key for the agent. A workspace-scoped key needs nothing
# else; a user key (sk-ant-usr-...) also needs ANTHROPIC_WORKSPACE_ID.
# (Read by the Anthropic SDK from the environment, not by internal/config.)
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# SECRET. Password for the Postgres container that comes with this compose file.
# It stores Piperoom's own state: the room event log, proposals, hand-offs.
# It is put into a URL as-is, so it must have no special characters (/ @ : # ? % $).
# Generate it:  openssl rand -hex 32
# Pick it once; changing it later does not change the password inside an
# existing data volume. It is used only to build PIPEROOM_DB_URL; the server
# container does not receive it.
PIPEROOM_POSTGRES_PASSWORD=

# Piperoom's own database. Leave EMPTY to use the bundled Postgres container
# (compose builds the URL from PIPEROOM_POSTGRES_PASSWORD). Set it only to use
# your own Postgres; use sslmode=require or stricter for a remote one.
# Example: postgres://piperoom:PASSWORD@db.internal:5432/piperoom?sslmode=require
# Percent-encode any special character in PASSWORD, or use a hex password.
PIPEROOM_DB_URL=

# The pipeline, as the READ-ONLY roles from docs/pilot/permissions.md. From inside
# the container, "localhost" is the container itself: use real host names.
# SECRET (the URLs carry passwords).
SOURCE_DB_URL=
WAREHOUSE_DB_URL=
# Comma-separated host:port list.
KAFKA_BROKERS=
CONNECT_URL=
SCHEMA_REGISTRY_URL=

# =============================================================================
# 2. Who may do what (files mounted from deploy/config/)
# =============================================================================

# Paths INSIDE the container. compose mounts deploy/config/ at /config, so you
# normally leave these alone. Start from deploy/config/*.example.yaml.
OWNERS_FILE=/config/owners.yaml
USERS_FILE=/config/users.yaml

# =============================================================================
# 3. Agent
# =============================================================================

PIPEROOM_MODEL=claude-opus-5-5
# Reasoning effort.
PIPEROOM_EFFORT=high
# Cost guard: most agent runs at once across all rooms; the rest wait in a
# queue. Empty or 0 = 3.
PIPEROOM_MAX_AGENTS=

# Built-in watcher (design: docs/design/watcher.md). Empty = the default.
# Mode: off | log | rooms. Default log = shadow mode: transitions are logged,
# no room is opened. Switch to rooms after a week of clean logs.
PIPEROOM_WATCH_MODE=
# Time between checks. Default 60s, minimum 15s.
PIPEROOM_WATCH_INTERVAL=
# Deadline for each check. Default 10s, maximum 10s (the source role's statement_timeout).
PIPEROOM_WATCH_CHECK_TIMEOUT=
# Quiet time after a watcher room is closed. Default 60m.
PIPEROOM_WATCH_COOLDOWN=

# =============================================================================
# 4. Network and web UI
# =============================================================================

# The server must listen on all interfaces inside the container. Do not change
# this; to change which host address is reachable, use PIPEROOM_BIND below.
PIPEROOM_HTTP_ADDR=0.0.0.0:8090

# Set by the image (the built UI lives at /web). Leave as is.
PIPEROOM_WEB_DIR=/web

# Where people reach the UI, for example https://piperoom.corp.example. Used for
# room links in Slack, and its host is allowed as a WebSocket origin: set it when
# a reverse proxy changes the Host header. Empty = no Slack links.
# Must be a plain http(s) URL with a host name or IPv4 address and no wildcard,
# query or user name. A bad value stops the server at start-up.
PIPEROOM_PUBLIC_URL=

# Compose only (not read by the server): the host interface and port that
# publish the container's 8090.
#   127.0.0.1  only this machine (default; reach it with an SSH tunnel)
#   0.0.0.0    every interface: ONLY behind the customer VPN or an
#              authenticating reverse proxy. There is no real login yet; anyone
#              who can reach the port can act as any user, including approving
#              fixes.
# A specific VPN address (for example 10.8.0.5) is better than 0.0.0.0.
PIPEROOM_BIND=127.0.0.1
PIPEROOM_PORT=8090

# =============================================================================
# 5. Kafka security (empty protocol = PLAINTEXT, no login)
# =============================================================================

# PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL
KAFKA_SECURITY_PROTOCOL=
# PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
# SECRET.
KAFKA_SASL_PASSWORD=
# TLS files: put them in deploy/certs/ (mounted read-only at /certs) and use the
# /certs/... path here. The key file is a secret.
KAFKA_TLS_CA_FILE=
KAFKA_TLS_CERT_FILE=
KAFKA_TLS_KEY_FILE=
# Empty = the broker host name.
KAFKA_TLS_SERVER_NAME=

# =============================================================================
# 6. Schema Registry login (TLS is on when SCHEMA_REGISTRY_URL is https)
# =============================================================================

# Confluent Cloud: the API key.
SCHEMA_REGISTRY_USERNAME=
# SECRET. Confluent Cloud: the API secret.
SCHEMA_REGISTRY_PASSWORD=
SCHEMA_REGISTRY_TLS_CA_FILE=
SCHEMA_REGISTRY_TLS_CERT_FILE=
SCHEMA_REGISTRY_TLS_KEY_FILE=

# =============================================================================
# 7. Kafka Connect login (TLS is on when CONNECT_URL is https)
# =============================================================================

CONNECT_USERNAME=
# SECRET.
CONNECT_PASSWORD=
CONNECT_TLS_CA_FILE=
CONNECT_TLS_CERT_FILE=
CONNECT_TLS_KEY_FILE=

# =============================================================================
# 8. Warehouse kind
# =============================================================================

# postgres (default): WAREHOUSE_DB_URL is a Postgres URL.
# snowflake: WAREHOUSE_DB_URL is a gosnowflake DSN.
WAREHOUSE_KIND=postgres

# =============================================================================
# 9. Slack mirror of rooms (off unless BOTH are set)
# =============================================================================

# SECRET.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# =============================================================================
# 10. Signed alert sources (a source with an empty secret is disabled)
# =============================================================================

# All SECRET.
ALERTMANAGER_TOKEN=
GRAFANA_ALERT_SECRET=
PAGERDUTY_ALERT_SECRET=
DATADOG_ALERT_TOKEN=
# HMAC secret for /api/alerts/generic.
GENERIC_ALERT_SECRET=
# PagerDuty service id to pipeline id, comma-separated: SVCID=orders,SVCID2=billing
PAGERDUTY_SERVICES=
# The pipeline used when an alert does not name one.
DEFAULT_ALERT_PIPELINE=
