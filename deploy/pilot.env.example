# Piperoom pilot settings.
#
#   cp deploy/pilot.env.example deploy/.env
#
# Then edit deploy/.env. Docker Compose reads deploy/.env by itself and passes
# the server settings on to the container (the list is in
# docker-compose.pilot.yml). deploy/.env is git-ignored: keep it that way, it
# holds secrets.
#
# Rules:
#   - No quotes, no spaces around "=".
#   - Compose treats "$" as the start of a variable, so write a literal "$" as
#     "$$" (passwords in URLs, for example).
#   - An empty value means "use the default (or off)".
#   - Lines marked SECRET must come from your secret manager, never from a
#     ticket or a chat message.
#   - The names match internal/config/config.go.
#   - A variable exported in the shell that runs compose overrides this file, so
#     run compose from a clean shell (see deploy/README.md).
#
# Read docs/pilot/permissions.md first and create the read-only accounts it lists.

# =============================================================================
# 1. Required
# =============================================================================

# SECRET. Anthropic API key for the agent. Needed when PIPEROOM_MODEL_PROVIDER is
# anthropic (the default); with bedrock or vertex use section 3 instead and leave
# this empty. A workspace-scoped key needs nothing else; a user key
# (sk-ant-usr-...) also needs ANTHROPIC_WORKSPACE_ID.
# (Read by the Anthropic SDK from the environment, not by internal/config.)
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# SECRET. Password for the Postgres container that comes with this compose file.
# It stores Piperoom's own state: the room event log, proposals, hand-offs.
# It is put into a URL as-is, so it must have no special characters (/ @ : # ? % $).
# Generate it:  openssl rand -hex 32
# Pick it once; changing it later does not change the password inside an
# existing data volume. It is used only to build PIPEROOM_DB_URL; the server
# container does not receive it.
PIPEROOM_POSTGRES_PASSWORD=

# Piperoom's own database. Leave EMPTY to use the bundled Postgres container
# (compose builds the URL from PIPEROOM_POSTGRES_PASSWORD). Set it only to use
# your own Postgres; use sslmode=require or stricter for a remote one.
# Example: postgres://piperoom:PASSWORD@db.internal:5432/piperoom?sslmode=require
# Percent-encode any special character in PASSWORD, or use a hex password.
PIPEROOM_DB_URL=

# The pipeline, as the READ-ONLY roles from docs/pilot/permissions.md. From inside
# the container, "localhost" is the container itself: use real host names.
# SECRET (the URLs carry passwords).
SOURCE_DB_URL=
WAREHOUSE_DB_URL=
# Comma-separated host:port list.
KAFKA_BROKERS=
CONNECT_URL=
SCHEMA_REGISTRY_URL=

# =============================================================================
# 2. Who may do what (files mounted from deploy/config/)
# =============================================================================

# Paths INSIDE the container. compose mounts deploy/config/ at /config, so you
# normally leave these alone. Start from deploy/config/*.example.yaml.
OWNERS_FILE=/config/owners.yaml
USERS_FILE=/config/users.yaml

# =============================================================================
# 3. Agent and model provider
# =============================================================================

# Model id. It must belong to the provider below: for bedrock it is a Bedrock
# model id or inference-profile id (for example an India "in." profile), for
# vertex a Vertex model id. The default is the Anthropic API id.
PIPEROOM_MODEL=claude-opus-5-5
# Reasoning effort.
PIPEROOM_EFFORT=high
# Cost guard: most agent runs at once across all rooms; the rest wait in a
# queue. Empty or 0 = 3.
PIPEROOM_MAX_AGENTS=
# Optional cheaper model for the first few investigation turns. Empty = always
# PIPEROOM_MODEL. Same provider and same id rules as PIPEROOM_MODEL.
PIPEROOM_TRIAGE_MODEL=
# Most model tokens (input + output) one room may use; the agent then stops and
# says so. Empty = 2000000, 0 = no cap.
PIPEROOM_ROOM_TOKEN_BUDGET=

# Where the model runs: anthropic | bedrock | vertex. Empty = anthropic.
# A wrong value, a missing region/project, or missing cloud credentials stops
# the server at start-up with an error that names the setting.
PIPEROOM_MODEL_PROVIDER=

# --- bedrock (PIPEROOM_MODEL_PROVIDER=bedrock) ---
# Required. A cross-region inference profile can process a request in another
# region than this one: check it against your data-residency rules.
AWS_REGION=
# Credentials, use ONE. Nothing at all is fine on a host with an instance/task
# role (on EC2 set the IMDSv2 hop limit to 2 so containers can reach it). On
# Kubernetes use IRSA: its variables are injected by the cluster, not set here.
# SECRET. A Bedrock API key (simplest):
AWS_BEARER_TOKEN_BEDROCK=
# SECRET. Static keys (prefer short-lived keys; the token is for temporary ones):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# A named profile. It only works if you mount a config file, see the commented
# lines under "volumes" in docker-compose.pilot.yml. ~/.aws is NOT mounted by default.
AWS_PROFILE=

# --- vertex (PIPEROOM_MODEL_PROVIDER=vertex) ---
VERTEX_PROJECT_ID=
# A region such as europe-west4, or global / us / eu. global, us and eu are
# multi-region endpoints: the request may be served anywhere in that area.
VERTEX_REGION=
# Optional. Path INSIDE the container to a service-account key file. Save the key
# as deploy/config/gcp-sa.json (git-ignored; deploy/config is mounted at /config)
# and use:  GOOGLE_APPLICATION_CREDENTIALS=/config/gcp-sa.json
# Leave empty to use another Google default-credentials source, such as the
# metadata server of a GCE VM. This is a secret file. The container runs as uid
# 65532, so a file that is mode 0600 and owned by you is unreadable to it. Run:
#   sudo chown 65532:65532 deploy/config/gcp-sa.json && chmod 0400 deploy/config/gcp-sa.json
# and grant the service account only the "Vertex AI User" role.
GOOGLE_APPLICATION_CREDENTIALS=

# ANTHROPIC_BASE_URL is intentionally missing from this file and from the
# compose file: it would let a value from the host environment send the API key
# and every prompt to another server. Only the variables in this file reach
# the server container.

# Built-in watcher (design: docs/design/watcher.md). NOT ACTIVE YET (watcher in
# review): these are passed through, but have no effect until it lands.
# Empty = the default.
# Mode: off | log | rooms. Default log = shadow mode: transitions are logged,
# no room is opened. Switch to rooms after a week of clean logs.
PIPEROOM_WATCH_MODE=
# Time between checks. Default 60s, minimum 15s.
PIPEROOM_WATCH_INTERVAL=
# Deadline for each check. Default 10s, maximum 10s (the source role's statement_timeout).
PIPEROOM_WATCH_CHECK_TIMEOUT=
# Quiet time after a watcher room is closed. Default 60m.
PIPEROOM_WATCH_COOLDOWN=

# =============================================================================
# 4. Network and web UI
# =============================================================================

# The server must listen on all interfaces inside the container. Do not change
# this; to change which host address is reachable, use PIPEROOM_BIND below.
PIPEROOM_HTTP_ADDR=0.0.0.0:8090

# Set by the image (the built UI lives at /web). Leave as is.
PIPEROOM_WEB_DIR=/web

# Where people reach the UI, for example https://piperoom.corp.example. Used for
# room links in Slack, and its host is allowed as a WebSocket origin: set it when
# a reverse proxy changes the Host header. Empty = no Slack links.
# Must be a plain http(s) URL with a host name or IPv4 address and no wildcard,
# query or user name. A bad value stops the server at start-up.
PIPEROOM_PUBLIC_URL=

# Compose only (not read by the server): the host interface and port that
# publish the container's 8090.
#   127.0.0.1  only this machine (default; reach it with an SSH tunnel)
#   0.0.0.0    every interface: ONLY behind the customer VPN or an
#              authenticating reverse proxy. There is no real login yet; anyone
#              who can reach the port can act as any user, including approving
#              fixes.
# A specific VPN address (for example 10.8.0.5) is better than 0.0.0.0.
PIPEROOM_BIND=127.0.0.1
PIPEROOM_PORT=8090

# =============================================================================
# 5. Kafka security (empty protocol = PLAINTEXT, no login)
# =============================================================================

# PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL
KAFKA_SECURITY_PROTOCOL=
# PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
# SECRET.
KAFKA_SASL_PASSWORD=
# TLS files: put them in deploy/certs/ (mounted read-only at /certs) and use the
# /certs/... path here. The key file is a secret.
KAFKA_TLS_CA_FILE=
KAFKA_TLS_CERT_FILE=
KAFKA_TLS_KEY_FILE=
# Empty = the broker host name.
KAFKA_TLS_SERVER_NAME=

# =============================================================================
# 6. Schema Registry login (TLS is on when SCHEMA_REGISTRY_URL is https)
# =============================================================================

# Confluent Cloud: the API key.
SCHEMA_REGISTRY_USERNAME=
# SECRET. Confluent Cloud: the API secret.
SCHEMA_REGISTRY_PASSWORD=
SCHEMA_REGISTRY_TLS_CA_FILE=
SCHEMA_REGISTRY_TLS_CERT_FILE=
SCHEMA_REGISTRY_TLS_KEY_FILE=

# =============================================================================
# 7. Kafka Connect login (TLS is on when CONNECT_URL is https)
# =============================================================================

CONNECT_USERNAME=
# SECRET.
CONNECT_PASSWORD=
CONNECT_TLS_CA_FILE=
CONNECT_TLS_CERT_FILE=
CONNECT_TLS_KEY_FILE=

# =============================================================================
# 8. Warehouse kind
# =============================================================================

# postgres (default): WAREHOUSE_DB_URL is a Postgres URL.
# snowflake: WAREHOUSE_DB_URL is a gosnowflake DSN.
WAREHOUSE_KIND=postgres

# =============================================================================
# 9. Slack mirror of rooms (off unless BOTH are set)
# =============================================================================

# SECRET.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# =============================================================================
# 10. Signed alert sources (a source with an empty secret is disabled)
# =============================================================================

# All SECRET.
ALERTMANAGER_TOKEN=
GRAFANA_ALERT_SECRET=
PAGERDUTY_ALERT_SECRET=
DATADOG_ALERT_TOKEN=
# HMAC secret for /api/alerts/generic.
GENERIC_ALERT_SECRET=
# PagerDuty service id to pipeline id, comma-separated: SVCID=orders,SVCID2=billing
PAGERDUTY_SERVICES=
# The pipeline used when an alert does not name one.
DEFAULT_ALERT_PIPELINE=

# =============================================================================
# 11. Data retention
# =============================================================================

# LIVE. Deletes whole CLOSED rooms (events, proposals, approvals, hand-offs)
# that were closed more than this many days ago. The check runs every 6 hours.
# Open rooms are never deleted. Empty or 0 = keep everything. A value that is
# not a whole number stops the server at start-up.
# Deletion cannot be undone. To keep a room, export it first:
#   GET /api/rooms/{id}/export   (with the X-User header)
# The export carries a SHA-256 over the JCS (RFC 8785) form of the room, so it
# can be verified later.
PIPEROOM_RETENTION_DAYS=

# =============================================================================
# 12. Outbound proxy (only if the host reaches the internet through one)
# =============================================================================

# Used for HTTP(S) calls: the Anthropic / Bedrock / Vertex APIs, Slack, and
# Connect / Schema Registry / Snowflake when they are http(s). Kafka and
# Postgres use plain TCP and do not go through it. Loopback is never proxied.
# NO_PROXY is a comma-separated list of hosts and domains that must go direct,
# usually your internal Connect / Registry hosts. A proxy URL with a password
# is a SECRET.
# For Bedrock with an instance or task role, ALSO add 169.254.169.254 (EC2 IMDS)
# and 169.254.170.2 (ECS credentials): the AWS SDK fetches role credentials over
# plain HTTP and honours these proxy variables, so without them the credential
# request goes to your proxy and fails. (Google's metadata client ignores the
# proxy settings, so Vertex on a GCE VM needs nothing here.)
# Use UPPER-CASE names: the lower-case https_proxy / no_proxy are not passed to
# the container, and lower-case names in this file are ignored.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=
