{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 0},
    "allowDevMode": {"type": "boolean"},
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string"},
        "tag": {"type": ["string", "integer"]},
        "digest": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "service": {
      "type": "object",
      "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string"},
        "tlsSecretName": {"type": "string"}
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {"type": ["string", "integer", "boolean", "null"]}
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string"},
        "requiredKeys": {"type": "array", "items": {"type": "string"}},
        "optionalKeys": {"type": "array", "items": {"type": "string"}},
        "refs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["name", "key"],
            "properties": {"name": {"type": "string"}, "key": {"type": "string"}}
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressFrom": {"type": "array"},
        "extraEgress": {"type": "array"},
        "egress": {
          "type": "object",
          "additionalProperties": {
            "type": ["object", "null"],
            "properties": {
              "to": {"type": "array"},
              "ports": {
                "type": "array",
                "items": {"type": "integer", "minimum": 1, "maximum": 65535}
              }
            }
          }
        }
      }
    }
  }
}
