package {{.Package}};

import io.debezium.engine.ChangeEvent;
import io.debezium.engine.DebeziumEngine;
import io.debezium.engine.format.Json;

import java.io.IOException;
import java.io.InputStream;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.ArrayList;
import java.util.List;
import java.util.Properties;
import java.util.concurrent.CountDownLatch;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicBoolean;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

/**
 * Piperoom reference project: the smallest Debezium Engine application for a
 * {{.SourceTitle}} source on Debezium {{.Release}}. Piperoom generated it and
 * never builds or runs it; you do. Every change event is printed as one line
 * that starts with "piperoom-reference event" and names only its destination:
 * no key or row value is ever printed, because the log goes to Piperoom. An
 * event whose value contains a canary nonce from PIPEROOM_CANARY also prints
 * "piperoom-reference canary NONCE seen", the line the setup check looks for.
 */
public final class ReferenceApp {

    /** The asynchronous engine: the only one left in Debezium 3.2 (DBZ-8443). */
    private static final String ENGINE_FACTORY = "io.debezium.embedded.async.ConvertingAsyncEngineBuilderFactory";

    /** A property value that is exactly ${secret:NAME}. */
    private static final Pattern SECRET_REF = Pattern.compile("^\\$\\{secret:([A-Za-z_][A-Za-z0-9_]{0,63})\\}$");

    /** The files the engine writes; their folders must exist before it starts. */
    private static final String[] FILE_KEYS = {"offset.storage.file.filename", "schema.history.internal.file.filename"};

    /** A canary nonce: a token Piperoom inserted, never row data. */
    private static final Pattern CANARY = Pattern.compile("^[A-Za-z0-9-]{8,64}$");

    private ReferenceApp() {
    }

    public static void main(String[] args) throws Exception {
        Path config = Paths.get(args.length > 0 ? args[0] : "piperoom-reference.properties");
        Properties props = new Properties();
        try (InputStream in = Files.newInputStream(config)) {
            props.load(in);
        }
        if (!resolveSecrets(props)) {
            System.exit(2);
        }
        List<String> canaries = canaries(System.getenv("PIPEROOM_CANARY"));
        if (canaries == null) {
            System.exit(2);
        }
        for (String key : FILE_KEYS) {
            String file = props.getProperty(key);
            if (file != null) {
                Path parent = Paths.get(file).toAbsolutePath().getParent();
                if (parent != null) {
                    Files.createDirectories(parent);
                }
            }
        }

        CountDownLatch stopped = new CountDownLatch(1);
        AtomicBoolean failed = new AtomicBoolean(false);
        DebeziumEngine<ChangeEvent<String, String>> engine = DebeziumEngine
                .create(Json.class, Json.class, Json.class, ENGINE_FACTORY)
                .using(props)
                .notifying(event -> {
                    String destination = event.destination();
                    System.out.println("piperoom-reference event destination=" + destination);
                    String value = event.value();
                    if (value == null) {
                        return;
                    }
                    for (String nonce : canaries) {
                        if (value.contains(nonce)) {
                            System.out.println("piperoom-reference canary " + nonce + " seen destination=" + destination);
                        }
                    }
                })
                .using((success, message, error) -> {
                    if (!success) {
                        failed.set(true);
                        System.err.println("piperoom-reference engine stopped with an error: " + message);
                        if (error != null) {
                            error.printStackTrace();
                        }
                    }
                    stopped.countDown();
                })
                .build();

        ExecutorService executor = Executors.newSingleThreadExecutor();
        Runtime.getRuntime().addShutdownHook(new Thread(() -> {
            try {
                engine.close();
                stopped.await(30, TimeUnit.SECONDS);
            } catch (IOException | InterruptedException e) {
                System.err.println("piperoom-reference: closing the engine: " + e);
            }
        }));
        executor.execute(engine);
        System.out.println("piperoom-reference started: " + props.getProperty("connector.class"));
        stopped.await();
        executor.shutdown();
        executor.awaitTermination(30, TimeUnit.SECONDS);
        if (failed.get()) {
            System.exit(1);
        }
    }

    /**
     * Reads the comma-separated canary nonces of PIPEROOM_CANARY (none when
     * it is unset). Returns null, without echoing the value, when one is not
     * a nonce.
     */
    private static List<String> canaries(String env) {
        List<String> out = new ArrayList<>();
        if (env == null) {
            return out;
        }
        for (String part : env.split(",")) {
            String nonce = part.trim();
            if (nonce.isEmpty()) {
                continue;
            }
            if (!CANARY.matcher(nonce).matches()) {
                System.err.println("piperoom-reference: PIPEROOM_CANARY must be nonces of 8 to 64 letters, digits or '-', separated by commas");
                return null;
            }
            out.add(nonce);
        }
        return out;
    }

    /**
     * Replaces each ${secret:NAME} value with the environment variable
     * PIPEROOM_SECRET_NAME, so no password is ever written into the
     * properties file. A value that is not a reference is kept as is.
     */
    private static boolean resolveSecrets(Properties props) {
        boolean ok = true;
        for (String key : props.stringPropertyNames()) {
            Matcher m = SECRET_REF.matcher(props.getProperty(key).trim());
            if (!m.matches()) {
                continue;
            }
            String env = "PIPEROOM_SECRET_" + m.group(1);
            String value = System.getenv(env);
            if (value == null || value.isEmpty()) {
                System.err.println("piperoom-reference: " + key + " needs the environment variable " + env);
                ok = false;
                continue;
            }
            props.setProperty(key, value);
        }
        return ok;
    }
}
