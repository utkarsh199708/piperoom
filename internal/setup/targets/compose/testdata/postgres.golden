# Generated by piperoom setup from source-postgres; compose_write regenerates this file. Do not edit it by hand.
name: piperoom-setup
services:
  postgres:
    image: docker.io/postgres:17@sha256:2d2b8998d31037bf721cfdf764d76ba74171b4fab3431b7f72c27c56ddbdf9e3
    command:
      - postgres
      - -c
      - wal_level=logical
      - -c
      - max_replication_slots=10
      - -c
      - max_wal_senders=10
    environment:
      - POSTGRES_USER=${POSTGRES_USER}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=${POSTGRES_DB}
    ports:
      - 127.0.0.1:5432:5432
    volumes:
      - /var/lib/postgresql/data
    healthcheck:
      test:
        - CMD
        - pg_isready
        - -U
        - ${POSTGRES_USER}
        - -d
        - ${POSTGRES_DB}
      interval: 5s
      retries: 20
